// SPDX-License-Identifier: GPL-2.0
/*
 * DTS file for phytium FT-2000/4 devboard (FT-2000/4-D4-DSK series)
 *
 * Copyright (C) 2018-2019, Phytium Technology Co., Ltd.
 */

/dts-v1/;
/memreserve/ 0x80000000 0x10000;

#include <ft2004v2-generic-psci-soc.dtsi>

/{
    model = "FT-2000/4-D4-DSK Development Board";
    compatible = "phytium,ft2004c";
    #address-cells = <2>;
    #size-cells = <2>;

    chosen {
        stdout-path = "uart1:115200n8";
    };

    memory@00{
        device_type = "memory";
        reg = <0x0 0x80000000 0x0 0x7b000000>;
    };

    soc {
        /* CPU板上的CPLD，通过LPC总线进行访问 */
        cpld0 {
            io_dev_name = "cpld0";
            compatible = "wb-io-dev";
            io_type = /bits/ 8 <0x1>;       /* 0:ioport, 1:iomen */
            io_base = <0x20000000>;
            io_len  = <0x0100>;
        };

        /* CPU板上的CPLD模拟的SPI控制器 */
        spi-cpld {
            compatible = "spi-cpld";
            reg = <0x0 0x20000000 0x0 0x100000>;
            #address-cells = <1>;
            #size-cells = <0>;

            /* CPLD模拟的SPI控制器下挂了3个CPLD，分别为主CPLD、从CPLD、风扇板CPLD，3个CPLD只使用了一个片选，
             * CPLD通过地址来进行区分。作为SPI设备，其在SPI master注册时会被创建出来 */
            cpld1:cpld1 {
                compatible = "wb-spi-dev";
                reg = <0x1>;                         /* 指定spi设备使用的片选信号。即spi->chip_select */
                spi-max-frequency = <10000000>;      /* 指定spi设备工作的最大频率。即spi->max_speed_hz */

                spi_dev_name      = "cpld1";         /* 生成的misc设备的名称 */
                data_bus_width    = <1>;             /* spi设备的数据位宽，单位B */
                addr_bus_width    = <2>;             /* spi设备的地址位宽，单位B。该设备采用cmd(1B) + addr(2B) + data(1-8B)的数据格式 */
                per_rd_len        = <1>;             /* 一次SPI数据传输，最大读取的数据长度。目前是由于spi控制器数据buf最大为8B，但cpld按1B读写，故这里只能配1 */
                per_wr_len        = <1>;             /* 一次SPI数据传输，最大写入的数据长度。目前是由于spi控制器数据buf最大为8B，但cpld按1B读写，故这里只能配1 */
                spi_len           = <0x10000>;
            };
        };

        /* 底板主CPLD上模拟I2C控制器, 映射RAM读写通道  该控制器内部9548下挂8个二级实体PCA9548 0x70-0x77 */
        cpld10 {
            compatible = "wb-indirect-dev";
            /* 1: i2c, 2: file, 3:pcie, 4:io, 5:spi, 8:atomic */
            logic_func_mode     = <5>;
            dev_name            = "cpld10";         /* created dev name */
            logic_dev_name      = "/dev/cpld1";     /* dependent dev name */
            data_bus_width      = <4>;              /* dev data_bus_width */
            addr_bus_width      = <1>;              /* dev addr_bus_width */
            wr_data             = <0x20b0>;         /* dependent dev wr date reg */
            wr_data_width       = <4>;              /* dependent dev wr_data_width */
            addr_low            = <0x20b4>;         /* dependent dev w/r addr reg low */
            addr_high           = <0x20b5>;         /* dependent dev w/r addr reg high */
            rd_data             = <0x20b6>;         /* dependent dev rd date reg */
            rd_data_width       = <4>;              /* dependent dev rd_data_width */
            opt_ctl             = <0x20ba>;
            indirect_len        = <0x200>;
            lock_mode           = <2>;
        };

        /* 底板从CPLD上模拟I2C控制器, 映射RAM读写通道  该控制器内部9548下挂4个风扇E2 */
        cpld11 {
            compatible = "wb-indirect-dev";
            /* 1: i2c, 2: file, 3:pcie, 4:io, 5:spi, 8:atomic */
            logic_func_mode     = <5>;
            dev_name            = "cpld11";         /* created dev name */
            logic_dev_name      = "/dev/cpld1";     /* dependent dev name */
            data_bus_width      = <4>;              /* dev data_bus_width */
            addr_bus_width      = <1>;              /* dev addr_bus_width */
            wr_data             = <0x40b0>;         /* dependent dev wr date reg */
            wr_data_width       = <4>;              /* dependent dev wr_data_width */
            addr_low            = <0x40b4>;         /* dependent dev w/r addr reg low */
            addr_high           = <0x40b5>;         /* dependent dev w/r addr reg high */
            rd_data             = <0x40b6>;         /* dependent dev rd date reg */
            rd_data_width       = <4>;              /* dependent dev rd_data_width */
            opt_ctl             = <0x40ba>;
            indirect_len        = <0x200>;
            lock_mode           = <2>;
        };

        i2c100: main-cpld-i2c0 {
            #address-cells = <1>;
            #size-cells = <0>;
            compatible = "wb-fpga-i2c";
            i2c_timeout             = <3000>;
            i2c_scale               = <0x00>;
            i2c_filter              = <0x04>;
            i2c_stretch             = <0x08>;
            i2c_slave               = <0x1c>;
            i2c_reg                 = <0x20>;
            i2c_reg_len             = <0x30>;
            i2c_data_len            = <0x34>;
            i2c_ctrl                = <0x38>;
            i2c_status              = <0x3c>;
            i2c_data_buf            = <0x100>;
            i2c_data_buf_len        = <256>;
            dev_name                = "/dev/cpld10";
            i2c_scale_value         = <0x4e>;
            i2c_filter_value        = <0x7c>;
            i2c_stretch_value       = <0x7c>;
            i2c_func_mode           = <2>;          /* 1:i2c, 2:file 3:spi */
            i2c_adap_reset_flag     = <1>;          /* 1:复位, 0:不复位 */
            i2c_reset_addr          = <0x7c>;
            i2c_reset_on            = <0x00000001>;
            i2c_reset_off           = <0x00000000>;
            i2c_reset_mask          = <0x00000001>;
            i2c_rst_delay_b         = <0>;          /* delay time before reset(us) */
            i2c_rst_delay           = <1>;          /* reset time(us) */
            i2c_rst_delay_a         = <1>;          /* delay time after reset(us) */
            i2c_ext_9548_exits_flag = <0x0c>;
            i2c_ext_9548_addr       = <0x10>;
            i2c_ext_9548_chan       = <0x14>;
            i2c_in_9548_chan        = <0x18>;

            /* 控制器内部9548 每个通道都各挂了1个PCA9548 */
            i2c@7a {
                #address-cells = <1>;
                #size-cells = <0>;
                compatible = "wb_fpga_pca9548";
                reg                     = <0x7a>;
                pca9548_base_nr         = <102>;
                fpga_9548_flag          = <1>;  /* 1:内部9548, 2:外部9548 */
                fpga_9548_reset_flag    = <0>;  /* 1:复位, 0:不复位*/
                

                mux-0@0{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <0>;

                    /* PCA9548 0x70 BUS 2-9, 面板口1-8 */
                    cpld_ext_pca9548@70 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x70>;  
                        pca9548_base_nr         = <2>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-1@1{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <1>;

                    /* PCA9548 0x71 BUS 10-17, 面板口9-16 */
                    cpld_ext_pca9548@71 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x71>;  
                        pca9548_base_nr         = <10>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-2@2{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <2>;

                    /* PCA9548 0x72 BUS 18-25, 面板口17-24 */
                    cpld_ext_pca9548@72 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x72>;  
                        pca9548_base_nr         = <18>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-3@3{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <3>;

                    /* PCA9548 0x73 BUS 26-33, 面板口25-32 */
                    cpld_ext_pca9548@73 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x73>;  
                        pca9548_base_nr         = <26>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-4@4{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <4>;

                    /* PCA9548 0x74 BUS 34-41, 面板口25-32 */
                    cpld_ext_pca9548@74 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x74>;  
                        pca9548_base_nr         = <34>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-5@5{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <5>;

                    /* PCA9548 0x75 BUS 42-49, 面板口33-40 */
                    cpld_ext_pca9548@75 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x75>;  
                        pca9548_base_nr         = <42>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-6@6{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <6>;

                    /* PCA9548 0x76 BUS 50-57, 面板口41-48 */
                    cpld_ext_pca9548@76 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x76>;  
                        pca9548_base_nr         = <50>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };

                mux-7@7{
                    #address-cells = <1>;
                    #size-cells = <0>;
                    reg = <7>;

                    /* PCA9548 0x77 BUS 58-65, 100G面板口1-8 */
                    cpld_ext_pca9548@77 {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        compatible = "wb_fpga_pca9548";
                        reg                     = <0x77>;  
                        pca9548_base_nr         = <58>;
                        fpga_9548_flag          = <2>;  /* 1:内部9548, 2:外部9548 */
                        fpga_9548_reset_flag    = <1>;  /* 0:不复位 1:硬件自动复位 2:软件写寄存器复位 */
                    };
                };
            };
        };

        i2c101: second-cpld-i2c0 {
            #address-cells = <1>;
            #size-cells = <0>;
            compatible = "wb-fpga-i2c";
            i2c_timeout             = <3000>;
            i2c_scale               = <0x00>;
            i2c_filter              = <0x04>;
            i2c_stretch             = <0x08>;
            i2c_slave               = <0x1c>;
            i2c_reg                 = <0x20>;
            i2c_reg_len             = <0x30>;
            i2c_data_len            = <0x34>;
            i2c_ctrl                = <0x38>;
            i2c_status              = <0x3c>;
            i2c_data_buf            = <0x100>;
            i2c_data_buf_len        = <256>;
            dev_name                = "/dev/cpld11";
            i2c_scale_value         = <0x4e>;
            i2c_filter_value        = <0x7c>;
            i2c_stretch_value       = <0x7c>;
            i2c_func_mode           = <2>;          /* 1:i2c, 2:file 3:spi */
            i2c_adap_reset_flag     = <1>;          /* 1:复位, 0:不复位 */
            i2c_reset_addr          = <0x7c>;
            i2c_reset_on            = <0x00000001>;
            i2c_reset_off           = <0x00000000>;
            i2c_reset_mask          = <0x00000001>;
            i2c_rst_delay_b         = <0>;          /* delay time before reset(us) */
            i2c_rst_delay           = <1>;          /* reset time(us) */
            i2c_rst_delay_a         = <1>;          /* delay time after reset(us) */
            i2c_ext_9548_exits_flag = <0x0c>;
            i2c_ext_9548_addr       = <0x10>;
            i2c_ext_9548_chan       = <0x14>;
            i2c_in_9548_chan        = <0x18>;

            /* 控制器内部9548 BUS 66-73, 风扇板1-4的EEPROM */
            i2c@78 {
                #address-cells = <1>;
                #size-cells = <0>;
                compatible = "wb_fpga_pca9548";
                reg = <0x78>;
                pca9548_base_nr          = <66>;
                fpga_9548_flag           = <1>;  /* 1:内部9548, 2:外部9548 */
                fpga_9548_reset_flag     = <0>;  /* 1:复位, 0:不复位*/
            };
        };

        /* 用于固件升级前，初始化GPIO的到一个默认的状态，以防止GPIO模拟的JTAG信号抖动，出现不可预知的问题 */
        gpio_init {
            compatible  = "gpio_init";
            gpioport@0 {                            /* 该设备节点包含的gpio信息，具体表示方式如下 */
                gpio            = <491>;             /* GPIO的编号 */
                init_direction  = <0>;              /* GPIO的配置方向。0：输出；1：输入 */
                init_level      = <1>;	            /* GPIO的输出电平。0：输出低电平；1：输出高电平 */
            };
            gpioport@1 {                            /* 该设备节点包含的gpio信息，具体表示方式如下 */
                gpio            = <494>;                     /* GPIO的编号 */
                init_direction  = <0>;              /* GPIO的配置方向。0：输出；1：输入 */
                init_level      = <0>;              /* GPIO的输出电平。0：输出低电平；1：输出高电平 */
            };
            gpioport@2 {                            /* 该设备节点包含的gpio信息，具体表示方式如下 */
                gpio            = <493>;              /* GPIO的编号 */
                init_direction  = <0>;              /* GPIO的配置方向。0：输出；1：输入 */
                init_level      = <1>;              /* GPIO的输出电平。0：输出低电平；1：输出高电平 */
            };
            gpioport@3 {                            /* 该设备节点包含的gpio信息，具体表示方式如下 */
                gpio            = <492>;             /* GPIO的编号 */
                init_direction  = <1>;              /* GPIO的配置方向。0：输出；1：输入 */
                init_level      = <0>;              /* GPIO的输出电平。0：输出低电平；1：输出高电平 */
            };
            gpioport@4 {                            /* 该设备节点包含的gpio信息，具体表示方式如下 */
                gpio            = <490>;             /* GPIO的编号 */
                init_direction  = <0>;              /* GPIO的配置方向。0：输出；1：输入 */
                init_level      = <0>;              /* GPIO的输出电平。0：输出低电平；1：输出高电平 */
            };
            gpioport@5 {                            /* 该设备节点包含的gpio信息，具体表示方式如下 */
                gpio            = <489>;             /* GPIO的编号 */
                init_direction  = <0>;              /* GPIO的配置方向。0：输出；1：输入 */
                init_level      = <1>;              /* GPIO的输出电平。0：输出低电平；1：输出高电平 */
            };
        };

        /* 用于固件升级CPU板上的CPLD */
        firmware_cpld_ispvme0 {
            compatible  = "firmware_cpld_ispvme";
            type        = "JTAG";
            tdi         = <491>;
            tck         = <494>;
            tms         = <493>;
            tdo         = <492>;
            chain       = <1>;
            chip_index  = <1>;
            en_gpio_0   = <490>;     /* ONLINE_JTAG_EN  GPIO1_B2  使能在线升级，需要配置为低电平0 */
            en_level_0  = <0>;      /* 默认配置为0，为0可不配 */
            en_gpio_1   = <489>;     /* JTAG_SEL_1  GPIO1_B1  选择升级哪条链路的CPLD：低电平0 -- 选择升级CPU板的CPLD, 高电平1 -- 选择升级底板的CPLD */
            en_level_1  = <0>;      /* 默认配置为0，为0可不配 */

            /* JTAG_EN enable/disable */
            en_logic_dev_0     = "/dev/cpld0";   /* 通过什么设备文件，来配置链路使能 */
            en_logic_addr_0    = <0xe8>;         /* 链路使能的寄存器地址 */
            en_logic_mask_0    = <0xfe>;         /* 寄存器值的掩码 */
            en_logic_en_val_0  = <0x01>;         /* 链路使能时，寄存器的配置值 */
            en_logic_dis_val_0 = <0x00>;         /* 链路失能时，寄存器的配置值 */
            en_logic_width_0   = <0x01>;         /* 逻辑设备的位宽： 1 --- 8bit、2 --- 16bit、4 --- 32bit */
        };

        /* 用于固件升级底板上的主从CPLD，即基地址分别为0x2000、0x4000的CPLD */
        firmware_cpld_ispvme1 {
            compatible  = "firmware_cpld_ispvme";
            type        = "JTAG";
            tdi         = <491>;
            tck         = <494>;
            tms         = <493>;
            tdo         = <492>;
            chain       = <2>;
            chip_index  = <1>;
            en_gpio_0   = <490>;
            en_level_0  = <0>;
            en_gpio_1   = <489>;
            en_level_1  = <1>;

            /* JTAG_EN enable/disable */
            en_logic_dev_0     = "/dev/cpld0";   /* 通过什么设备文件，来配置链路使能 */
            en_logic_addr_0    = <0xe8>;         /* 链路使能的寄存器地址 */
            en_logic_mask_0    = <0xfe>;         /* 寄存器值的掩码 */
            en_logic_en_val_0  = <0x01>;         /* 链路使能时，寄存器的配置值 */
            en_logic_dis_val_0 = <0x00>;         /* 链路失能时，寄存器的配置值 */
            en_logic_width_0   = <0x01>;         /* 逻辑设备的位宽： 1 --- 8bit、2 --- 16bit、4 --- 32bit */
        };

        /* 用于升级U-BOOT */
        firmware_sysfs0 {
            compatible  = "firmware_sysfs";
            type        = "MTD_DEV";
            chain       = <1>;
            chip_index  = <1>;
            mtd_name    = "mtd0";  /* mtd设备的名称 */  
            flash_base  = <0>;       /* flash基地址，固件将更新到这个位置，固件占据的空间大小为固件文件的大小（按flash块对齐） */
        };
        
        wdt {
            compatible = "wb_wdt";
            config_dev_name = "/dev/cpld1";
            feed_dev_name = "/dev/cpld1";
            hw_algo = "eigenvalues";
            config_mode = /bits/ 8 <2>;     /* logic feed wdt mode */
            priv_func_mode = /bits/ 8 <8>; /* spi atomic mode */
            logic_func_mode = /bits/ 8 <8>; /* spi atomic mode */
            feed_reg = <0x20f2>;
            active_val = /bits/ 8 <0x01>;
            enable_val = /bits/ 8 <0x01>;
            disable_val = /bits/ 8 <0x01>;  /* 不希望在卸载的时候，关闭 */
            enable_mask = /bits/ 8 <0xff>;
            enable_reg = <0x20f0>;
            /* 设置到超时寄存器的值是 hw_margin_ms / timer_accuracy */
            timeout_cfg_reg = <0x20f1>;     /* 超时时间寄存器 */
            hw_margin_ms = <5000>;          /* 超时时间 5000ms */
            timer_accuracy = <1000>;        /* 精度:秒 */
            feed_wdt_type = /bits/ 8 <1>;   /* hrtime type */
            feed_time = <500>;              /* ms */
        };

        /* 新增1个DTS节点，用来配置PHY的LED寄存器，用于mgmt点灯 */
        yt8531s-phy-led@0 {
            led0_cfg = <0x0670>;            /* LED0_CFG寄存器的值 */
            led1_cfg = <0x0670>;            /* LED1_CFG寄存器的值 */
            led2_cfg = <0x0070>;            /* LED2_CFG寄存器的值 */
        };
    };

    aliases {
        i2c0 = &i2c1;
        i2c110 = &i2c100;
        i2c111 = &i2c101;
    };
};

&gpio0 {
    status = "ok";
};

&gpio1 {
    status = "ok";
};

&uart1 {
    status = "ok";
};

&gmac0 {
    status = "ok";
    phy-mode = "rgmii-rxid";
};

&qspi {
    status = "ok";
};

&i2c1 {
    clock-frequency = <100000>;
    
    /* sda保持时间配置，保证I2C外设不会因为SDA的保持时间不够而报I2C TX abort：lost arbitrary的错误 */
    i2c-sda-hold-time-ns = <100>;

    /* 只有status = "ok" or "okay"的I2C设备节点才会被创建出平台设备 */
    status = "ok";
    
    #address-cells = <1>;
    #size-cells = <0>;

    rtc@32 {
        compatible = "dptel,rtc-ins5699";
        reg = <0x32>;
    };
};

